# Application
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Comma-separated origins, or * for all (development only)
CORS_ORIGINS=*

# Optional: override static files directory
# STATIC_DIR=static

# Optional: goldapi.io API key for live gold price lookups (/api/gold-price).
# Leave blank to always use the hardcoded fallback price.
GOLD_API_KEY=
